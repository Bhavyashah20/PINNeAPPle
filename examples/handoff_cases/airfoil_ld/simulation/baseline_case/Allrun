cd "${0%/*}" || exit 1
[ -n "$WM_PROJECT_DIR" ] || source /usr/share/openfoam/etc/bashrc > /dev/null 2>&1
checkMesh > log.checkMesh 2>&1
simpleFoam > log.simpleFoam 2>&1
