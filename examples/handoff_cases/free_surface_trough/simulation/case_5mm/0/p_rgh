FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object p_rgh;
}
dimensions [1 -1 -2 0 0 0 0];
internalField uniform 0.0;
boundaryField
{
    floor
    {
        type fixedFluxPressure;
        value uniform 0;
    }
    upstreamWall
    {
        type fixedFluxPressure;
        value uniform 0;
    }
    sill
    {
        type fixedFluxPressure;
        value uniform 0;
    }
    outlet
    {
        type prghTotalPressure;
        p0 uniform 0.0;
        value uniform 0.0;
    }
    atmosphere
    {
        type prghTotalPressure;
        p0 uniform 0.0;
        value uniform 0.0;
    }
    nozzle
    {
        type fixedFluxPressure;
        value uniform 0;
    }
    "(front|back|frontAndBack)"
    {
        type empty;
    }
}
