FoamFile
{
    version 2.0;
    format ascii;
    class volScalarField;
    object nut;
}
dimensions [0 2 -1 0 0 0 0];
internalField uniform 0;
boundaryField
{
    floor
    {
        type nutkWallFunction;
        value uniform 0;
    }
    upstreamWall
    {
        type nutkWallFunction;
        value uniform 0;
    }
    sill
    {
        type nutkWallFunction;
        value uniform 0;
    }
    outlet
    {
        type calculated;
        value uniform 0;
    }
    atmosphere
    {
        type calculated;
        value uniform 0;
    }
    nozzle
    {
        type calculated;
        value uniform 0;
    }
    "(front|back|frontAndBack)"
    {
        type empty;
    }
}
