{
  "name": "pinneapple-playground",
  "private": true,
  "version": "1.0.0",
  "description": "PINNeAPPle Playground: physics surrogates in the browser, with their trust checks.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "python3 build.py",
    "serve": "python3 build.py --serve",
    "test:unit": "node --test ../../tests/js/zoo_web.test.mjs",
    "test:e2e": "playwright test",
    "test": "node --test ../../tests/js/zoo_web.test.mjs && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "onnxruntime-web": "1.22.0"
  }
}
